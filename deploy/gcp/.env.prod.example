# ─── Intellicore CMP — production/staging environment file ─────────────
# Copy to `.env.prod` (never commit the real file) and fill in.
# Every var marked REQUIRED must be set or the stack refuses to start.
# The provision-customer.sh script generates this file for you with
# strong random secrets — this template documents each value.

# ── Edge / TLS (REQUIRED) ──────────────────────────────────────────────
# Public domain. With no DNS, use sslip.io: <IP-with-dashes>.sslip.io
DOMAIN=203-0-113-10.sslip.io
# Email for the Let's Encrypt account (cert expiry notices)
LETSENCRYPT_EMAIL=cloudops@yourcompany.com

# ── PostgreSQL (REQUIRED password) ─────────────────────────────────────
POSTGRES_USER=intellicore
POSTGRES_PASSWORD=            # REQUIRED — openssl rand -hex 24
POSTGRES_DB=intellicore

# ── Neo4j (REQUIRED) ───────────────────────────────────────────────────
NEO4J_PASSWORD=              # REQUIRED — openssl rand -hex 24

# ── Auth / secrets (REQUIRED) ──────────────────────────────────────────
JWT_SECRET=                  # REQUIRED — openssl rand -hex 32
# Encrypts tenant-supplied BYOK API keys at rest. Falls back to JWT_SECRET
# if unset, but set it explicitly in production.
CREDENTIALS_SECRET=          # openssl rand -hex 32

# ── First admin user (used by scripts.create_admin) ────────────────────
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=              # openssl rand -base64 18  (share securely)

# ── Tenancy ────────────────────────────────────────────────────────────
# single = one customer per VM (default, recommended). multi = shared.
TENANT_MODE=single

# ── Platform LLM fallback (OPTIONAL — customers Bring Their Own Key) ────
# Leave blank in production; customers add their own key in Settings.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# ── Logging ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
